{
  "expo": {
    "name": "Smart Gallery",
    "slug": "smart-gallery-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#08090c",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#08090c"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smartgallery.ai",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Smart Gallery requires access to your photos to perform local on-device visual AI indexing and instant search."
      }
    },
    "android": {
      "package": "com.smartgallery.ai",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#08090c"
      },
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Smart Gallery to access your photos for local on-device AI search and organization.",
          "savePhotosPermission": "Allow Smart Gallery to save edited photos.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": "6d15ee43-10fe-4fc1-8ccb-45f1af46e8bc"
      }
    },
    "owner": "mr-jaan"
  }
}
